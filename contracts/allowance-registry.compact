// Allowance registry: ZK-gated spending and permission grants (stretch goal).
//
// The agent's policy engine treats a missing or unproven allowance as
// ask/deny. This contract anchors (owner, spender, capability) allowances, and
// the circuit enforces the limit: a spend transition is only valid while the
// running total stays inside the authorized maximum. The agent cannot exceed
// the limit even if it is prompt-injected, because the proof would not verify.
//
// Every circuit is bound to the owner: `authorize` stores a hiding commitment
// to `ownerSecret` (the same witness idiom `memory-vault` uses), and `spend`
// and `revoke` only verify when the caller reproduces that binding. Without it
// anyone reading a public key off the ledger could revoke, drain or re-authorize
// someone else's allowance.
//
// Amounts are USD cents as Uint<64>. The authorized maximum and the running
// total are public (an allowance is a statement, like a card limit); what the
// circuit guarantees is that no spend can push the total past the limit. The
// off-ledger exact-amount hiding that v0 planned is not achievable while the
// running total is public, so we disclose it here and say so in the docs.
//
// Expiry is enforced off-ledger by the agent in v0 and moves into a ledger
// timestamp check once the toolchain pin supports it.
//
// Toolchain: `compact compile` (see contracts/README.md for the pinned version).
//   compact compile contracts/allowance-registry.compact contracts/build/allowance-registry

pragma language_version 0.23;

import CompactStandardLibrary;

// Public, on-chain state.
export ledger owners: Map<Bytes<32>, Bytes<32>>; // key -> owner binding
export ledger limits: Map<Bytes<32>, Uint<64>>; // key -> authorized max (cents)
export ledger spent: Map<Bytes<32>, Uint<64>>;  // key -> running total (cents)
export ledger active: Map<Bytes<32>, Boolean>;   // key -> live (false after revoke)

// Private input: the owner's secret. Implemented on the owner's device (the
// local proof server), never on-chain.
witness ownerSecret(): Bytes<32>;

export circuit authorize(key: Bytes<32>, maxAmount: Uint<64>): [] {
  const k = disclose(key);
  const binding = persistentCommit<Bytes<32>>(ownerSecret(), key);
  // First authorization writes the owner binding; every later one (after a
  // revoke) must come from the same owner, so a third party cannot raise the
  // limit or reset the running total.
  if (owners.member(k)) {
    assert(owners.lookup(k) == binding, "not the allowance owner");
  } else {
    owners.insert(k, binding);
  }
  assert(!active.member(k) || !active.lookup(k), "allowance already active");
  assert(maxAmount > 0, "max must be positive");
  active.insert(k, true);
  limits.insert(k, disclose(maxAmount));
  spent.insert(k, 0);
}

export circuit spend(key: Bytes<32>, amount: Uint<64>): [] {
  const k = disclose(key);
  assert(active.member(k) && active.lookup(k), "no active allowance");
  assert(owners.lookup(k) == persistentCommit<Bytes<32>>(ownerSecret(), key), "not the allowance owner");
  assert(amount > 0, "amount must be positive");
  const remaining = limits.lookup(k) - spent.lookup(k);
  assert(amount <= remaining, "over allowance");
  const next = (spent.lookup(k) + disclose(amount)) as Uint<64>;
  spent.insert(k, next);
}

export circuit revoke(key: Bytes<32>): [] {
  const k = disclose(key);
  assert(active.member(k) && active.lookup(k), "no active allowance");
  assert(owners.lookup(k) == persistentCommit<Bytes<32>>(ownerSecret(), key), "not the allowance owner");
  active.insert(k, false);
}
